data = [
    ("00000000", "06-26-2011", 200, "Exercise", "GymnasticsPro", "cash"),
    ("00000001", "05-26-2011", 300, "Exercise", "Weightlifting", "credit"),
    ("00000002", "06-01-2011", 100, "Exercise", "GymnasticsPro", "cash"),
    ("00000003", "06-05-2011", 100, "Gymnastics", "Rings", "credit"),
    ("00000004", "12-17-2011", 300, "Team Sports", "Field", "paytm"),
    ("00000005", "02-14-2011", 200, "Gymnastics", None, "cash")
]

df = spark.createDataFrame(data).toDF("id", "tdate", "amt", "category", "product", "mode")
df.show()

                                    ## ---------- Filters ----------------
seldf = df.select( "tdate" , "category" )
seldf.show()

dropdf = df.drop("tdate" , "category"  )
dropdf.show()

# category = 'Exercise'
filter1 = df.filter("category = 'Exercise'")
filter1.show()

# category = 'Exercise' and mode = 'cash'
filter2 = df.filter("category = 'Exercise' and mode = 'cash'")
filter2.show()

# category = 'Exercise' or mode = 'cash'
filter3 = df.filter("category = 'Exercise' or mode = 'cash'")
filter3.show()

# category in ('Exercise', 'Gymnastics')
filter4 = df.filter("category in ('Exercise', 'Gymnastics')")
filter4.show()

# product like '%Gymnastics%'
filter5 = df.filter("product like '%Gymnastics%'")
filter5.show()

# product is null
filter6 = df.filter("product is null")
filter6.show()

# product is not null
filter7 = df.filter("product is not null")
filter7.show()

# category != 'Exercise'
filter8 = df.filter("category != 'Exercise'")
filter8.show()

                                       ## ---------- Expressions ----------------
# selectExpr will not only select the column ,it will also perform the expressions on the column.
#even thought we dont have any action to perform on other columns we have to select them as well along with the expr column in  selectExpr.
dfexp=df.selectExpr("cast(id as int) as id",
                    "split(tdate,'-')[2] as year",
                    "split(tdate,'-')[0] as Month",
                    "split(tdate,'-')[1] as Date","amt + 100 as amount",
                    "upper(category) as category",
                    "concat(product,'~zeyo') as product","mode",
                    "case when mode='cash' then 0 when mode='credit' then 1 else 2 end as status")

dfexp.show()
dfexp.printSchema()

# I want to process only one column without disturbing other columns.
#withcolumn expects two parameters (column_name,expression)--> it will pick required column , it will process the column ,it will put the column in the same place.
#if you want to process more than one column you have to use withcolumn multiple times.
#if you want a new column -still it will perform expression and add the new column at the end.
#it needs an import --> from pyspark.sql.functions import *

Example 1:---
data = [
    ("00000000", "06-26-2011", 200, "Exercise", "GymnasticsPro", "cash"),
    ("00000001", "05-26-2011", 300, "Exercise", "Weightlifting", "credit"),
    ("00000002", "06-01-2011", 100, "Exercise", "GymnasticsPro", "cash"),
    ("00000003", "06-05-2011", 100, "Gymnastics", "Rings", "credit"),
    ("00000004", "12-17-2011", 300, "Team Sports", "Field", "paytm"),
    ("00000005", "02-14-2011", 200, "Gymnastics", None, "cash")
]
df = spark.createDataFrame(data).toDF(
    "id", "tdate", "amt", "category", "product", "mode"
)
df.show()

from pyspark.sql.functions import *
withDF =(
    (
        df
        .withColumn("category"  ,   expr("upper(category)")   ))
        .withColumn( "amt" , expr("amt + 1000"))
        .withColumn( "product"  , expr("concat(product,'~zeyo')")   )
        .withColumn("id" , expr(" cast(id as int)"))
        .withColumn("tdate" , expr(" split(tdate,'-')[2]"))
        .withColumn("status" , expr("case when mode = 'cash' then 1 else 0 end"))
        .withColumnRenamed("tdate" , "year")  # to rename a column
)
withDF.show()

